# Copy to `.env` and fill in. All values are OPTIONAL — the system must run without them.
# Never commit `.env` with real values (see .gitignore).

# Groq free tier (optional). Without it, /answer falls back to extractive answers
# and evaluation uses non-LLM metrics only.
GROQ_API_KEY=

# Qdrant (defaults shown). Local Docker install needs none of these.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=passages
